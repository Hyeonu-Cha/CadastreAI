# Copy to .env and fill in values. Do not commit .env.

# ----- Required ---------------------------------------------------

# Anthropic (Claude) — agent + synthetic data generation. Required when
# the agent runs on the default Anthropic provider; if you set
# CADASTRE_LLM_PROVIDER=openai (see below) you can leave this blank.
ANTHROPIC_API_KEY=

# Qdrant — vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ----- Optional: alternative providers for pair generation --------
# Pair generation (Task 2.06) is one of two places the project supports
# non-Anthropic LLMs. Set one of these and run with `--provider gemini`
# or `--provider openai` to fund pair generation off non-Anthropic
# credit. The agent's runtime provider is controlled separately, by
# CADASTRE_LLM_PROVIDER (see next block).
GEMINI_API_KEY=
# GEMINI_GEN_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_GEN_MODEL=gpt-4o-mini

# ----- Optional: agent provider switch (Task X.08) ----------------
# Selects which LLM provider the 5 agent nodes (classify, decompose,
# route, reflect, synthesize) call into. `anthropic` (default) → Claude
# via ANTHROPIC_API_KEY; `openai` → GPT via OPENAI_API_KEY. Useful for
# running agent eval (Tasks 3.22–3.24) off OpenAI credit.
# CADASTRE_LLM_PROVIDER=anthropic

# ----- Optional: agent model overrides ----------------------------
# Defaults are sensible (Haiku 4.5 for routing/reflection, Sonnet 4.6
# for synthesis). Override when ablating cost vs quality.
# CADASTRE_CLASSIFIER_MODEL=claude-haiku-4-5
# CADASTRE_DECOMPOSER_MODEL=claude-haiku-4-5
# CADASTRE_ROUTER_MODEL=claude-haiku-4-5
# CADASTRE_REFLECTOR_MODEL=claude-haiku-4-5
# CADASTRE_SYNTHESIZER_MODEL=claude-sonnet-4-6

# Per-node OpenAI overrides — only consulted when
# CADASTRE_LLM_PROVIDER=openai. Defaults: gpt-4o-mini for the four
# small nodes, gpt-4o for the synthesizer.
# CADASTRE_OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
# CADASTRE_OPENAI_DECOMPOSER_MODEL=gpt-4o-mini
# CADASTRE_OPENAI_ROUTER_MODEL=gpt-4o-mini
# CADASTRE_OPENAI_REFLECTOR_MODEL=gpt-4o-mini
# CADASTRE_OPENAI_SYNTHESIZER_MODEL=gpt-4o

# ----- Optional: storage paths / collections ----------------------
# Override the Qdrant collection (e.g. to A/B base BGE vs fine-tuned)
# QDRANT_COLLECTION=cadastre_chunks

# Override the disk path for the query-embedding cache (Task 4.09).
# Useful for Docker volume mounts.
# CADASTREAI_EMBED_CACHE_DIR=data/cache/embeddings

# ----- Optional: tracing ------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cadastreai
PHOENIX_COLLECTOR_ENDPOINT=
