# --- SmolAlign environment (all free tiers; copy to .env and fill in) ---

# Hugging Face Hub — push/pull adapters, merged models, GGUFs, datasets.
# Create a free WRITE token at https://huggingface.co/settings/tokens
HF_TOKEN=

# LLM judge for win-rate eval (Phase 4). Pick ONE provider's free tier.
#   groq   -> https://console.groq.com  (Llama-3.3-70B, free)
#   gemini -> https://aistudio.google.com/app/apikey  (Flash, free)
JUDGE_PROVIDER=groq
JUDGE_API_KEY=

# Weights & Biases (free) for loss/reward curves. Optional — leave blank to
# fall back to TensorBoard.
WANDB_API_KEY=
