# Mirrors .gitignore intent — keeps the build context small so changes
# to non-source files don't bust the cache or bloat the layer tarball.

# VCS / IDE / Claude
.git
.gitignore
.claude
.venv
venv

# Python build artifacts
__pycache__
*.py[cod]
*.egg-info
dist
build

# Tooling caches
.ruff_cache
.pytest_cache

# Local secrets — never bake into an image
.env

# Data: raw corpora + ingestion artifacts + embedding cache. The
# runtime image needs only the BM25 pickle baked in (Qdrant holds the
# dense vectors); chunks.jsonl / embeddings.npy / chunk_ids.txt are
# ingestion-time artifacts and stay out of the image.
data/raw
data/processed/*
!data/processed/bm25.pkl
data/cache

# Test + notebook scratch
tests
notebooks
results

# Docs / project meta — not needed at runtime
docs
*.md
!README.md
project_plan.md
product.md
progress.md
tickets.md
architecture.svg
logo.svg

# Local Compose stack — runtime only needs the app, not Qdrant/Phoenix
docker-compose.yml
